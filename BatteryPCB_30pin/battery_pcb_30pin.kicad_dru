(version 1)
# Camera standoffs H7-H10 (Wuerth WA-SMSI 9774050243R): Wuerth's land pattern puts the no-net solder ring
# right at the edge of the standoff's own 3.0 mm pin hole, and the three small solder dots 0.25 mm from it.
# Only that pad-to-own-hole spacing is relaxed; every other item keeps the 0.3 mm hole clearance.
# (KiCad 10.0.0 skipped this same-footprint check; 10.0.6 reports it.)
(rule "Wuerth standoff pads to their own pin hole"
	(constraint hole_clearance (min 0mm))
	(condition "(A.memberOfFootprint('H7') && B.memberOfFootprint('H7')) || (A.memberOfFootprint('H8') && B.memberOfFootprint('H8')) || (A.memberOfFootprint('H9') && B.memberOfFootprint('H9')) || (A.memberOfFootprint('H10') && B.memberOfFootprint('H10'))"))
