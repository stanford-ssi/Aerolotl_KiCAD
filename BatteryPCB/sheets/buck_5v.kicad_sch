		(exclude_from_sim no)
		(at 25.40 36.83 0)
		(effects (font (size 1.27 1.27) (thickness 0.254) (bold yes) (color 0 0 194 1)) (justify left bottom))
		(uuid "043f3402-dc49-4957-90b5-687315b9776b")
	)
	(text "UVLO (R9/R10 on EN): on above 1.23 V x (1 + 412k/100k) = 6.3 V, off below 1.08 V x 5.12 = 5.5 V at VIN,"
		(exclude_from_sim no)
		(at 25.40 40.64 0)
		(effects (font (size 1.27 1.27) (thickness 0.254) (bold yes) (color 0 0 194 1)) (justify left bottom))
		(uuid "81725958-f79a-4597-9432-707e49c76245")
	)
	(text "so the camera pack stops at about 2.9 V per cell instead of being run flat (U1's own UVLO is 3.6 V)."
		(exclude_from_sim no)
		(at 25.40 44.45 0)
		(effects (font (size 1.27 1.27) (thickness 0.254) (bold yes) (color 0 0 194 1)) (justify left bottom))
		(uuid "1878d55b-c1ae-45d3-b22d-10c7cc9482da")
	)
