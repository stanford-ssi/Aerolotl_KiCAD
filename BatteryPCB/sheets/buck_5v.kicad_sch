				(color 0 0 194 1)
			)
			(justify left bottom)
		)
		(uuid "ba3c26dc-9ae7-4837-ba1f-eb90f8415d5f")
	)
	(text "Input caps: C1 (100 nF) sits right at U1's VIN/GND pins; C2, C11 (10 uF) are the bulk."
