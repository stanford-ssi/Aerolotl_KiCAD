	(text "LMR51430 buck, 500 kHz:  VOUT = 0.6 x (1 + 100k / 13k7) = 4.98 V"
		(exclude_from_sim no)
		(at 25.4 30.48 0)
		(effects
			(font
				(size 1.5 1.5)
				(thickness 0.254)
				(bold yes)
				(color 0 0 194 1)
			)
			(justify left bottom)
		)
		(uuid "9af141d1-dd85-48ef-bbdb-80f6ade99a74")
	)
	(text "Output caps: C4, C5 (22 uF) and C6 (100 nF) sit at L1 / U1.  C9 (10 uF) and C10 (100 nF) sit at the DevKitC's 5V pin (J1 pin 19) on the board."
		(exclude_from_sim no)
		(at 25.4 48.26 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.254)
				(bold yes)
				(color 0 0 194 1)
			)
			(justify left bottom)
		)
		(uuid "b1808edb-fa25-49bf-a147-03d0f3b56826")
	)
	(text "so the camera pack stops at about 2.85 V per cell instead of being run flat (U1's own UVLO is 3.6 V)."
		(exclude_from_sim no)
		(at 25.4 44.45 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.254)
