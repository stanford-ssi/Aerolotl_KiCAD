	(text "2 x 1x19 female header for the ESP32-DevKitC V4.  GPIO6-11 go to the module SPI flash - do not use."
		(exclude_from_sim no)
		(at 25.4 30.48 0)
		(effects
			(font
				(size 1.5 1.5)
				(thickness 0.254)
				(bold yes)
				(color 0 0 194 1)
			)
			(justify left bottom)
		)
		(uuid "dc8401b6-6102-4e81-8cec-8ff5960d87d3")
	)
	(text "Pack sense: VBAT_SENSE = VIN x 39k / (100k + 39k).  Full pack 8.4 V (VIN about 8.1 V after D3) -> 2.26 V at GPIO34, inside the ESP32 ADC's 2.45 V range (11 dB)."
		(exclude_from_sim no)
		(at 25.4 36.83 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.254)
				(bold yes)
				(color 0 0 194 1)
			)
			(justify left bottom)
		)
		(uuid "62a0d255-675a-4c7a-81c1-88cffd9c0cc8")
	)
	(text "Firmware: VIN = VBAT_SENSE x 139 / 39; pack = VIN + about 0.35 V."
		(exclude_from_sim no)
		(at 25.4 40.64 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.254)
				(bold yes)
				(color 0 0 194 1)
			)
			(justify left bottom)
		)
		(uuid "09cb2c9f-2c03-4c4b-8803-ce429839dd32")
	)
	(text "RunCam Split 4: 5-20 V in.  Single 5-pin harness: power, ground and UART (R7 / R8 in series with the UART lines)."
