	(text "VBAT_SENSE = VIN x 39k / (100k + 39k).  Full pack 8.4 V (VIN about 8.1 V after D3) -> 2.26 V at GPIO34,"
		(exclude_from_sim no)
		(at 25.40 30.48 0)
		(effects (font (size 1.5 1.5) (thickness 0.254) (bold yes) (color 0 0 194 1)) (justify left bottom))
		(uuid "05df36e3-c84b-4faa-9890-4be254316ff8")
	)
	(text "inside the ESP32 ADC's 2.45 V range (11 dB).  Firmware: VIN = VBAT_SENSE x 139 / 39; pack = VIN + about 0.35 V."
		(exclude_from_sim no)
		(at 25.40 35.56 0)
		(effects (font (size 1.5 1.5) (thickness 0.254) (bold yes) (color 0 0 194 1)) (justify left bottom))
		(uuid "2d07bb37-f774-4556-b722-0209d94b4e56")
	)
